SocksPort 9050
ControlPort 9051
CookieAuthentication 0

# Connection padding to resist traffic analysis
ConnectionPadding 1

# Reduce DNS leaks
DNSPort 5353
AutomapHostsOnResolve 1

# Circuit settings for OSINT work
MaxCircuitDirtiness 600
NewCircuitPeriod 30

# Avoid exit nodes in certain countries if needed (uncomment to customize)
# ExcludeExitNodes {ru},{cn},{ir}
# StrictNodes 1

# Logging
Log notice file /var/log/tor/notices.log
